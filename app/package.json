{
  "name": "galgame-manager",
  "productName": "花间 · Galgame 管理器",
  "version": "0.1.4",
  "private": true,
  "description": "你的本地 galgame 书架",
  "author": "Mika",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "dev:web": "npm run build && vite preview --configLoader runner --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "build": "vite build --configLoader runner && node scripts/build.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:arm64": "npm run build && electron-builder --win nsis --arm64",
    "pack:mac": "npm run build && electron-builder --mac dir",
    "portable:win:arm64": "npm run build && node scripts/portable.mjs arm64",
    "portable:win:x64": "npm run build && node scripts/portable.mjs x64"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.468.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "webp-wasm": "^1.0.6"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "extract-zip": "^2.0.1",
    "jsdom": "^26.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "local.mika.galgame",
    "productName": "Hanami",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "Hanami-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.entertainment"
    },
    "extraResources": [
      {
        "from": "engines",
        "to": "engines",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "type": "module"
}
